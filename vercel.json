{
  "version": 2,
  "builds": [
    {
      "src": "frontend2/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    {
      "src": "portfolio/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "buildCommand": "./build.sh"
      }
    }
  ],
  "routes": [
    {
      "src": "/Base/(.*)",
      "dest": "/portfolio/wsgi.py"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend2/build/index.html"
    }
  ]
}
