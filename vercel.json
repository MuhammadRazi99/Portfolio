{
  "version": 2,
  "builds": [
    {
      "src": "portfolio/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "Python3.12"
      }
    },
    {
      "src": "requirements.txt",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "pip install -r requirements.txt && python3.12 manage.py migrate && python3.12 manage.py collectstatic --noinput"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/uploads/uploads/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/portfolio/wsgi.py"
    }
  ]
}
