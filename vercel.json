{
  "version": 2,
  "builds": [
    {
      "src": "portfolio/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "buildCommand": "./build.sh"
      }
    }
  ],
  "routes": [
    {
      "src": "^/education$",
      "dest": "/portfolio/wsgi.py"
    },
    {
      "src": "^/experience$",
      "dest": "/portfolio/wsgi.py"
    },
    {
      "src": "^/project$",
      "dest": "/portfolio/wsgi.py"
    },
    {
      "src": "^/certificate$",
      "dest": "/portfolio/wsgi.py"
    },
    {
      "src": "^/publication$",
      "dest": "/portfolio/wsgi.py"
    },
    {
      "src": "^/achievement$",
      "dest": "/portfolio/wsgi.py"
    }
  ]
}
