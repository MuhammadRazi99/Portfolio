{
  "version": 2,
  "builds": [
    {
      "src": "portfolio/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "Python3.12"
      }
    },
    {
      "src": "./build.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "uploads"
      }
    }
  ],
  "routes": [
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/portfolio/wsgi.py"
    }
  ]
}
